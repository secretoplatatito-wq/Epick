# GEMINI_API_KEY: Auto-injected by AI Studio at runtime (free-tier Gemini 4 Hydrogen + local FFmpeg fallback work automatically).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Auto-injected by AI Studio at runtime (used for workspace, preview, download, and MCP links).
APP_URL="MY_APP_URL"

# CLIPPAH_API_TOKEN: Auto-generated by the server if left as default; used for external MCP/API clients.
CLIPPAH_API_TOKEN="clippah-dev-mcp-token"

# HUGGINGFACE_API_KEY: Optional ($0 local FFmpeg + Gemini ranker work automatically if left blank).
HUGGINGFACE_API_KEY=""

# Email Feedback Delivery (retroplasmman@gmail.com)
# Leave SMTP_* / FEEDBACK_WEBHOOK_URL blank for zero-cost local storage + 1-click Email App send button.
FEEDBACK_TO_EMAIL="retroplasmman@gmail.com"
FEEDBACK_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@clippah.yuangames77.local"
